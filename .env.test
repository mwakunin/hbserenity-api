NODE_ENV=test
PORT=9999
LOG_LEVEL=silent

# Points at the disposable tmpfs Postgres on :5433 (see docker-compose.yml).
# DATABASE_URL is ignored in test mode — env.ts resolves it to TEST_DATABASE_URL.
DATABASE_URL=postgresql://rentals:rentals@localhost:5433/rentals_test
TEST_DATABASE_URL=postgresql://rentals:rentals@localhost:5433/rentals_test
REDIS_URL=redis://localhost:6380

# Not a real secret — test fixture only.
BETTER_AUTH_SECRET=test-secret-not-used-in-production-0123456789
BETTER_AUTH_URL=http://localhost:9999
