NODE_ENV=development
PORT=9999
LOG_LEVEL=debug

# --- Local dev (docker-compose) ---
DATABASE_URL=postgresql://rentals:rentals@localhost:5432/rentals_dev
TEST_DATABASE_URL=postgresql://rentals:rentals@localhost:5433/rentals_test
REDIS_URL=redis://localhost:6379

# --- Neon (staging/prod — override DATABASE_URL with the Neon connection string) ---
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/<db>?sslmode=require

# --- Auth (Better Auth) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- M-Pesa ---
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# --- Email (Resend) ---
RESEND_API_KEY=

# --- Image CDN (ImageKit) ---
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
