NODE_ENV=development
PORT=9999
LOG_LEVEL=debug

# --- Local dev (docker-compose) ---
DATABASE_URL=postgresql://rentals:rentals@localhost:5434/rentals_dev
TEST_DATABASE_URL=postgresql://rentals:rentals@localhost:5433/rentals_test
REDIS_URL=redis://localhost:6380

# --- Neon (staging/prod — override DATABASE_URL with the Neon connection string) ---
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>.neon.tech/<db>?sslmode=require

# --- Auth (Better Auth) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:9999

# --- The rest are optional in dev/test, required when NODE_ENV=production ---

# --- M-Pesa (Daraja) ---
MPESA_ENV=sandbox            # sandbox | production — picks the Daraja host
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=          # must be a publicly reachable HTTPS URL (use ngrok locally)
# Comma-separated Safaricom source IPs allowed to POST the callback. Optional —
# Safaricom's published list changes, and the handler verifies with Safaricom
# directly regardless. Leave blank to skip the IP check.
MPESA_CALLBACK_ALLOWED_IPS=

# --- Email (Resend) ---
RESEND_API_KEY=

# --- Image CDN (ImageKit) ---
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
